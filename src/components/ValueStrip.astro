---
/** Four short brand pillars directly under the home hero. */
import Icon from './Icon.astro';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const items = content[Astro.props.lang].valueStrip;
---

<div class="strip-wrap">
  <div class="container">
    <ul class="strip">
      {
        items.map((it) => (
          <li>
            <span class="icon">
              <Icon name={it.icon} size={20} />
            </span>
            <div>
              <p class="title">{it.title}</p>
              <p class="text">{it.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .strip-wrap {
    position: relative;
    margin-top: calc(clamp(40px, 6vw, 72px) * -1);
    padding-bottom: clamp(16px, 3vw, 24px);
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: rgba(12, 21, 38, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow: hidden;
  }

  li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 22px 22px 24px;
  }

  li + li {
    border-left: 1px solid var(--border);
  }

  .icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    color: var(--amber);
    background: rgba(253, 188, 91, 0.1);
    border: 1px solid rgba(253, 188, 91, 0.22);
  }

  .title {
    font-weight: 650;
    font-size: 0.975rem;
    line-height: 1.3;
    margin-bottom: 4px;
  }

  .text {
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    li + li {
      border-left: 0;
    }
    li:nth-child(even) {
      border-left: 1px solid var(--border);
    }
    li:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 540px) {
    .strip {
      grid-template-columns: minmax(0, 1fr);
    }
    li:nth-child(even) {
      border-left: 0;
    }
    li + li {
      border-top: 1px solid var(--border);
    }
    li {
      padding: 18px;
    }
  }
</style>
