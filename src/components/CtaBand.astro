---
/** Closing call-to-action at the bottom of pages, leading to /contact. */
import Icon from './Icon.astro';
import { CONTACT_EMAIL, content, pagePath, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<section class="section cta-section" aria-labelledby="cta-title">
  <div class="container">
    <div class="band">
      <div class="glow" aria-hidden="true"></div>
      <div class="copy">
        <p class="kicker">{t.contact.kicker}</p>
        <h2 id="cta-title" class="section-title">{t.contact.title}</h2>
        <p class="section-lead">{t.contact.lead[0]}</p>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href={pagePath(lang, 'contact')}>
          {t.contact.cta}
          <Icon name="arrow" size={18} class="icon-arrow" />
        </a>
        <a class="mail" href={`mailto:${CONTACT_EMAIL}`}>
          <Icon name="mail" size={16} />
          {CONTACT_EMAIL}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .section.cta-section {
    border-top: 0;
    padding-top: 0;
  }

  .band {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    gap: 32px 48px;
    align-items: center;
    padding: clamp(32px, 6vw, 56px);
    border-radius: 20px;
    border: 1px solid var(--border-strong);
    background: linear-gradient(135deg, #0f1c34 0%, var(--bg-elevated) 60%);
  }

  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(420px 260px at 0% 0%, rgba(30, 125, 218, 0.25), transparent 70%),
      radial-gradient(360px 240px at 100% 100%, rgba(253, 188, 91, 0.12), transparent 70%);
  }

  .copy,
  .actions {
    position: relative;
  }

  .actions {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .mail {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .mail:hover {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .band {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .band {
      padding: 28px 20px;
    }
    .actions .btn {
      width: 100%;
    }
  }
</style>
