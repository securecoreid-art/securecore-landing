---
/** Home: compact, linked list of services (different look from the Services page). */
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { content, pagePath, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const s = t.services;
const base = pagePath(lang, 'services');
---

<section class="section" aria-labelledby="home-services">
  <div class="container layout">
    <div class="intro">
      <SectionHead kicker={s.kicker} title={s.title} lead={s.lead[0]} id="home-services" />
      <a class="btn btn-ghost" href={base}>
        {s.teaserCta}
        <Icon name="arrow" size={18} class="icon-arrow" />
      </a>
    </div>

    <ul class="list">
      {
        s.items.map((it, i) => (
          <li>
            <a href={`${base}#${it.id}`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="icon">
                <Icon name={it.icon} size={22} />
              </span>
              <span class="copy">
                <span class="title">{it.title}</span>
                <span class="summary">{it.summary}</span>
              </span>
              <span class="go" aria-hidden="true">
                <Icon name="chevron" size={18} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
  }

  .intro {
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }

  .intro :global(.section-head) {
    margin-bottom: 28px;
  }

  .list {
    border-top: 1px solid var(--border-strong);
  }

  .list li {
    border-bottom: 1px solid var(--border);
  }

  .list a {
    display: grid;
    grid-template-columns: 28px 48px minmax(0, 1fr) 24px;
    gap: 18px;
    align-items: center;
    padding: 22px 8px;
    color: var(--text);
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease;
  }

  .list a:hover {
    text-decoration: none;
    background: rgba(16, 27, 48, 0.6);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    color: var(--accent);
    background: rgba(30, 125, 218, 0.12);
    border: 1px solid rgba(30, 125, 218, 0.3);
  }

  .copy {
    display: grid;
    gap: 4px;
  }

  .title {
    font-weight: 650;
    font-size: 1.0625rem;
  }

  .summary {
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.5;
  }

  .go {
    color: var(--text-subtle);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .list a:hover .go {
    color: var(--amber);
    transform: translateX(3px);
  }

  @media (max-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .intro {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .list a {
      grid-template-columns: 44px minmax(0, 1fr) 18px;
      gap: 14px;
      padding: 18px 4px;
    }
    .list .num {
      display: none;
    }
    .icon {
      width: 44px;
      height: 44px;
    }
    .intro .btn {
      width: 100%;
    }
  }
</style>
