---
import '../styles/global.css';
import { content, pagePath, type Lang, type PageKey } from '../i18n/content';

interface Props {
  lang: Lang;
  /** Page key, used for title/description and language alternates. Omit for 404. */
  page?: PageKey;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, page, title, description, noindex = false } = Astro.props;
const t = content[lang];
const meta = t.meta.pages[page ?? 'home'];

const pageTitle = title ?? meta.title;
const pageDescription = description ?? meta.description;
const site = Astro.site ?? new URL('https://securecore.id');
const canonical = new URL(page ? pagePath(lang, page) : Astro.url.pathname, site).href;
const ogImage = new URL('/og-image.png', site).href;
const alternates = page
  ? (['en', 'id'] as const).map((l) => ({ lang: l, href: new URL(pagePath(l, page), site).href }))
  : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#070d19" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}

    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {!noindex && alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SecureCore" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content="SecureCore logo" />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <slot />
  </body>
</html>
