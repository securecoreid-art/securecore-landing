---
/** About page: mission + belief side by side. */
import Icon from './Icon.astro';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const a = content[Astro.props.lang].about;
const blocks = [
  { ...a.mission, icon: 'target' },
  { ...a.belief, icon: 'eye' },
];
---

<section class="section">
  <div class="container grid">
    {
      blocks.map((b) => (
        <div class="block">
          <span class="icon">
            <Icon name={b.icon} size={22} />
          </span>
          <h2>{b.title}</h2>
          <p>{b.text}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .block {
    position: relative;
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    background: linear-gradient(135deg, #0f1c34 0%, var(--bg-elevated) 70%);
    overflow: hidden;
  }

  .block::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(320px 200px at 0% 0%, rgba(30, 125, 218, 0.18), transparent 70%);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 22px;
    border-radius: 12px;
    color: var(--amber);
    background: rgba(253, 188, 91, 0.1);
    border: 1px solid rgba(253, 188, 91, 0.25);
  }

  h2 {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    margin-bottom: 12px;
  }

  p {
    color: var(--text);
    opacity: 0.85;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
