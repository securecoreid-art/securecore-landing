---
/** "What you receive": text on the left, report table-of-contents card on the right. */
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const d = content[Astro.props.lang].deliverables;
---

<section class="section" aria-labelledby="deliverables-title">
  <div class="container layout">
    <div>
      <SectionHead kicker={d.kicker} title={d.title} lead={d.lead} id="deliverables-title" />
    </div>

    <div class="doc">
      <div class="doc-top">
        <Icon name="file" size={18} />
        <span>{d.docTitle}</span>
      </div>
      <ol>
        {
          d.items.map((it, i) => (
            <li>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{it.title}</h3>
                <p>{it.text}</p>
              </div>
              <span class="ok" aria-hidden="true">
                <Icon name="check" size={16} />
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  .layout :global(.section-head) {
    margin-bottom: 0;
  }

  .doc {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg-elevated) 100%);
    box-shadow: 0 40px 80px -32px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }

  .doc-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--border);
    background: rgba(7, 13, 25, 0.5);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .doc-top :global(svg) {
    color: var(--accent);
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 6px 20px;
  }

  li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) 24px;
    gap: 14px;
    align-items: start;
    padding: 16px 0;
  }

  li + li {
    border-top: 1px dashed var(--border-strong);
  }

  .idx {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--amber);
    padding-top: 2px;
  }

  h3 {
    font-size: 1rem;
    margin-bottom: 4px;
  }

  p {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .ok {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    color: #4ade80;
    background: rgba(74, 222, 128, 0.1);
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    ol {
      padding: 4px 16px;
    }
    li {
      grid-template-columns: 26px minmax(0, 1fr) 22px;
      gap: 10px;
    }
  }
</style>
