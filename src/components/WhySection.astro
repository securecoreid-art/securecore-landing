---
import Icon from './Icon.astro';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang].why;
---

<section class="section" aria-labelledby="why-title">
  <div class="container grid">
    <div class="intro">
      <p class="kicker">{t.kicker}</p>
      <h2 id="why-title" class="section-title">{t.title}</h2>
      <div class="lead">
        {t.lead.map((p) => <p>{p}</p>)}
      </div>
      <p class="emph">{t.intro}</p>
    </div>

    <ul class="items">
      {
        t.items.map((item, i) => (
          <li class="card">
            <span class="icon">
              <Icon name={item.icon} size={22} />
            </span>
            <div>
              <p class="num">{String(i + 1).padStart(2, '0')}</p>
              <h3>{item.title}</h3>
              <p class="text">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: start;
  }

  .lead {
    margin-top: 24px;
    display: grid;
    gap: 14px;
    color: var(--text-muted);
    font-size: 1.0625rem;
    max-width: 56ch;
  }

  .emph {
    margin-top: 24px;
    color: var(--text);
    font-weight: 600;
  }

  .items {
    display: grid;
    gap: 14px;
  }

  .items li {
    display: flex;
    gap: 18px;
    padding: 22px 24px;
  }

  .icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(30, 125, 218, 0.12);
    color: var(--accent);
  }

  .num {
    margin-bottom: 4px;
  }

  h3 {
    font-size: 1.0625rem;
    margin-bottom: 6px;
  }

  .text {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .items li {
      padding: 18px;
      gap: 14px;
    }
  }
</style>
