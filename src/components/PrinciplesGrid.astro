---
/** Principles page: 4 principle cards with "in practice" bullets. */
import Icon from './Icon.astro';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang].principles;
---

<section class="section">
  <div class="container">
    <ul class="grid">
      {
        t.items.map((item, i) => (
          <li class="card">
            <div class="top">
              <span class="icon">
                <Icon name={item.icon} size={22} />
              </span>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h2>{item.title}</h2>
            <p class="text">{item.text}</p>
            <div class="practice">
              <p class="label">{t.practiceLabel}</p>
              <ul>
                {item.practice.map((x) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .grid > li {
    display: flex;
    flex-direction: column;
    padding: 32px 30px 30px;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 22px;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    color: var(--amber);
    background: rgba(253, 188, 91, 0.1);
    border: 1px solid rgba(253, 188, 91, 0.25);
  }

  h2 {
    font-size: 1.375rem;
    margin-bottom: 10px;
  }

  .text {
    color: var(--text-muted);
  }

  .practice {
    margin-top: auto;
    padding-top: 22px;
  }

  .practice ul {
    margin-top: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    display: grid;
    gap: 10px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .practice li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 0.925rem;
    line-height: 1.5;
  }

  .practice :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--amber);
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .grid > li {
      padding: 24px 20px;
    }
  }
</style>
