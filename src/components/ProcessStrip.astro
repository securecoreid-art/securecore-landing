---
/** Home: condensed horizontal 5-step process. */
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { content, pagePath, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const p = content[lang].process;
---

<section class="section tinted" aria-labelledby="home-process">
  <div class="container">
    <SectionHead kicker={p.kicker} title={p.title} lead={p.lead} id="home-process" />

    <ol class="steps">
      {
        p.steps.map((s, i) => (
          <li>
            <span class="marker" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="foot">
      <p class="report-note">
        <span class="note-icon"><Icon name="file" size={18} /></span>
        <span>{p.reportNote}</span>
      </p>
      <a class="btn btn-ghost" href={pagePath(lang, 'approach')}>
        {p.cta}
        <Icon name="arrow" size={18} class="icon-arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .tinted {
    background: linear-gradient(180deg, transparent, rgba(16, 27, 48, 0.4) 30%, rgba(16, 27, 48, 0.4) 70%, transparent);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    position: relative;
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 22px;
    right: 22px;
    height: 1px;
    background: linear-gradient(90deg, var(--brand-blue), var(--brand-amber));
    opacity: 0.55;
  }

  li {
    position: relative;
  }

  .marker {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--border-strong);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--amber);
  }

  h3 {
    font-size: 1.0625rem;
    margin-bottom: 6px;
  }

  p {
    color: var(--text-muted);
    font-size: 0.925rem;
  }

  .foot {
    margin-top: clamp(36px, 5vw, 52px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    padding: 20px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(7, 13, 25, 0.5);
  }

  .report-note {
    display: flex;
    gap: 14px;
    align-items: center;
    flex: 1 1 420px;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .note-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--amber);
    background: rgba(253, 188, 91, 0.1);
    border: 1px solid rgba(253, 188, 91, 0.25);
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .steps::before {
      top: 22px;
      bottom: 22px;
      left: 22px;
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(180deg, var(--brand-blue), var(--brand-amber));
    }
    li {
      display: grid;
      grid-template-columns: 44px 1fr;
      column-gap: 18px;
      padding-bottom: 24px;
    }
    li:last-child {
      padding-bottom: 0;
    }
    .marker {
      grid-row: span 2;
      margin-bottom: 0;
    }
    h3 {
      padding-top: 10px;
    }
  }

  @media (max-width: 480px) {
    .foot .btn {
      width: 100%;
    }
    .report-note {
      align-items: flex-start;
    }
  }
</style>
