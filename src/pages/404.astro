---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { content } from '../i18n/content';

const en = content.en.notFound;
const id = content.id.notFound;
---

<Base lang="en" title="404 — SecureCore" noindex>
  <Header lang="en" onHome={false} />
  <main id="main" class="nf container">
    <p class="code">404</p>
    <h1>{en.title}</h1>
    <p class="text">{en.text}</p>
    <p class="text" lang="id">{id.text}</p>
    <div class="links">
      <a class="btn btn-primary" href="/">{en.back}</a>
      <a class="btn btn-ghost" href="/id/" lang="id">{id.back}</a>
    </div>
  </main>
  <Footer lang="en" />
</Base>

<style>
  .nf {
    min-height: 62vh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 14px;
    padding-block: 96px;
  }
  .code {
    font-family: var(--font-mono);
    color: var(--amber);
    letter-spacing: 0.1em;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .text {
    color: var(--text-muted);
    max-width: 52ch;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }
</style>
