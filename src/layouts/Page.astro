---
/** Standard page shell: <head>, header, main, footer. */
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang, PageKey } from '../i18n/content';

interface Props {
  lang: Lang;
  page?: PageKey;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, page, title, description, noindex } = Astro.props;
---

<Base lang={lang} page={page} title={title} description={description} noindex={noindex}>
  <Header lang={lang} page={page} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} page={page} />
</Base>
