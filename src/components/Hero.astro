---
import Icon from './Icon.astro';
import { content, mailto, pagePath, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const r = t.report;
const total = r.severities.reduce((sum, s) => sum + s.count, 0);
const maxCount = Math.max(...r.severities.map((s) => s.count));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="kicker">{t.hero.eyebrow}</p>
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="lead">{t.hero.lead[0]}</p>
      <p class="lead-2">{t.hero.lead[1]}</p>

      <div class="ctas">
        <a class="btn btn-primary" href={mailto(t.hero.mailSubject)}>
          {t.hero.primaryCta}
          <Icon name="arrow" size={18} class="icon-arrow" />
        </a>
        <a class="btn btn-ghost" href={pagePath(lang, 'services')}>{t.hero.secondaryCta}</a>
      </div>

      <ul class="tags">
        {
          t.hero.tags.map((tag) => (
            <li>
              <Icon name="check" size={16} />
              {tag}
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="report card" aria-labelledby="report-heading">
      <div class="report-top">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="file">{r.file}</span>
        <span class="badge">{r.label}</span>
      </div>

      <div class="report-body">
        <p id="report-heading" class="report-heading">{r.heading}</p>

        <p class="sub">{r.overviewTitle}</p>
        <dl class="meta">
          {
            r.rows.map((row) => (
              <div>
                <dt>{row.k}</dt>
                <dd>{row.v}</dd>
              </div>
            ))
          }
        </dl>

        <p class="sev-title">
          <span>{r.severityTitle}</span>
          <span class="total">{total}</span>
        </p>
        <ul class="sev">
          {
            r.severities.map((s) => (
              <li class={`sev-${s.key}`}>
                <span class="sev-label">{s.label}</span>
                <svg class="sev-bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true">
                  <rect class="track" width="100" height="8" rx="4" />
                  <rect class="fill" width={Math.max(8, (s.count / maxCount) * 100)} height="8" rx="4" />
                </svg>
                <span class="sev-count">{s.count}</span>
              </li>
            ))
          }
        </ul>

        <p class="report-note">
          <Icon name="shieldCheck" size={18} />
          {r.note}
        </p>
      </div>
      <figcaption class="disclaimer">{r.disclaimer}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(56px, 8vw, 104px) clamp(72px, 9vw, 120px);
    overflow: hidden;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  .lead {
    margin-top: 24px;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--text);
    opacity: 0.9;
    max-width: 56ch;
  }

  .lead-2 {
    margin-top: 14px;
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 56ch;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin-top: 30px;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .tags li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .tags :global(svg) {
    color: var(--amber);
    flex-shrink: 0;
  }

  /* report card */
  .report {
    position: relative;
    margin: 0;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(30, 125, 218, 0.08),
      0 40px 80px -24px rgba(0, 0, 0, 0.6),
      0 0 120px -40px rgba(30, 125, 218, 0.35);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .report-top {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(7, 13, 25, 0.5);
  }

  .dots {
    display: inline-flex;
    gap: 6px;
    flex-shrink: 0;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .file {
    color: var(--text-subtle);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .badge {
    margin-left: auto;
    white-space: nowrap;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-subtle);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    background: var(--bg);
  }

  .report-body {
    padding: 20px 20px 20px;
  }

  .report-heading {
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 16px;
  }

  .sub {
    color: var(--text-subtle);
    margin-bottom: 8px;
  }

  .meta {
    margin: 0 0 20px;
    display: grid;
    gap: 8px;
  }

  .meta div {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 12px;
  }

  .meta dt {
    color: var(--text-subtle);
  }

  .meta dt::after {
    content: ':';
  }

  .meta dd {
    margin: 0;
    color: var(--text);
  }

  .sev-title {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px dashed var(--border-strong);
    margin-bottom: 12px;
    color: var(--text-muted);
  }

  .total {
    color: var(--text);
  }

  .sev {
    display: grid;
    gap: 10px;
  }

  .sev li {
    display: grid;
    grid-template-columns: 72px 1fr 24px;
    align-items: center;
    gap: 12px;
  }

  .sev-label {
    color: var(--text-muted);
  }

  .sev-bar {
    width: 100%;
    height: 8px;
  }

  .sev-bar .track {
    fill: var(--border);
  }

  .sev-count {
    text-align: right;
    color: var(--text);
  }

  .sev-critical .fill { fill: var(--sev-critical); }
  .sev-high .fill { fill: var(--sev-high); }
  .sev-medium .fill { fill: var(--sev-medium); }
  .sev-low .fill { fill: var(--sev-low); }

  .report-note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-top: 20px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: rgba(30, 125, 218, 0.08);
    border: 1px solid rgba(30, 125, 218, 0.25);
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .report-note :global(svg) {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .disclaimer {
    padding: 10px 20px 12px;
    border-top: 1px solid var(--border);
    color: var(--text-subtle);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-style: italic;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .report {
      max-width: 560px;
    }
  }

  @media (max-width: 480px) {
    .ctas .btn {
      width: 100%;
    }
    .file {
      display: none;
    }
    .meta div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .sev li {
      grid-template-columns: 60px 1fr 20px;
    }
  }
</style>
