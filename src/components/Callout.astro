---
/** Bordered call-out box with title, text and a button. */
import Icon from './Icon.astro';

interface Props {
  kicker?: string;
  title: string;
  text: string;
  href: string;
  cta: string;
  icon?: string;
  accent?: 'blue' | 'amber';
}

const { kicker, title, text, href, cta, icon = 'chat', accent = 'blue' } = Astro.props;
---

<section class="section callout-section">
  <div class="container">
    <div class:list={['box', accent]}>
      <span class="icon">
        <Icon name={icon} size={24} />
      </span>
      <div class="copy">
        {kicker && <p class="kicker">{kicker}</p>}
        <h2>{title}</h2>
        <p class="text">{text}</p>
      </div>
      <a class="btn btn-primary" href={href}>
        {cta}
        <Icon name="arrow" size={18} class="icon-arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .section.callout-section {
    border-top: 0;
    padding-top: 0;
  }

  .box {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    padding: clamp(24px, 4vw, 36px);
    border-radius: var(--radius);
    border: 1px dashed var(--border-strong);
    background: rgba(12, 21, 38, 0.6);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 14px;
  }

  .blue .icon {
    color: var(--accent);
    background: rgba(30, 125, 218, 0.12);
    border: 1px solid rgba(30, 125, 218, 0.3);
  }

  .amber .icon {
    color: var(--amber);
    background: rgba(253, 188, 91, 0.1);
    border: 1px solid rgba(253, 188, 91, 0.25);
  }

  .copy .kicker {
    margin-bottom: 8px;
  }

  h2 {
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    margin-bottom: 6px;
  }

  .text {
    color: var(--text-muted);
    max-width: 64ch;
  }

  @media (max-width: 820px) {
    .box {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
  }

  @media (max-width: 480px) {
    .box .btn {
      width: 100%;
    }
  }
</style>
