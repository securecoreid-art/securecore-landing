---
/** Contact page: email card + security notice. */
import Icon from './Icon.astro';
import { CONTACT_EMAIL, content, mailto, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const t = content[Astro.props.lang].contact;
---

<section class="section">
  <div class="container">
    <div class="panel">
      <div class="glow" aria-hidden="true"></div>

      <div class="reach">
        <p class="label">{t.emailLabel}</p>
        <a class="email" href={mailto(t.mailSubject)}>{CONTACT_EMAIL}</a>
        <a class="btn btn-primary" href={mailto(t.mailSubject)}>
          <Icon name="mail" size={18} />
          {t.cta}
        </a>
      </div>

      <div class="notice">
        <span class="notice-icon">
          <Icon name="lock" size={20} />
        </span>
        <p>{t.notice}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    padding: clamp(28px, 5vw, 56px);
    border-radius: 20px;
    border: 1px solid var(--border-strong);
    background: linear-gradient(135deg, #0f1c34 0%, var(--bg-elevated) 60%);
  }

  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(420px 260px at 0% 0%, rgba(30, 125, 218, 0.25), transparent 70%),
      radial-gradient(360px 240px at 100% 100%, rgba(253, 188, 91, 0.12), transparent 70%);
  }

  .reach,
  .notice {
    position: relative;
  }

  .reach {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .email {
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 3vw, 1.875rem);
    font-weight: 500;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .email:hover {
    color: var(--accent);
  }

  .notice {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 22px;
    border-radius: var(--radius);
    background: rgba(7, 13, 25, 0.6);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .notice-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--amber);
    background: rgba(253, 188, 91, 0.1);
    border: 1px solid rgba(253, 188, 91, 0.25);
  }

  @media (max-width: 900px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .reach .btn {
      width: 100%;
    }
    .notice {
      padding: 18px;
    }
  }
</style>
