---
/** Contact page: "what to include" checklist + "what happens next" steps. */
import Icon from './Icon.astro';
import { content, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}

const c = content[Astro.props.lang].contact;
---

<section class="section" aria-labelledby="next-title">
  <div class="container layout">
    <div class="include card">
      <h2>{c.include.title}</h2>
      <ul>
        {
          c.include.items.map((x) => (
            <li>
              <Icon name="check" size={16} />
              <span>{x}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="next">
      <p class="kicker">{c.next.kicker}</p>
      <h2 id="next-title" class="section-title">{c.next.title}</h2>
      <ol>
        {
          c.next.steps.map((s, i) => (
            <li>
              <span class="marker" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .include {
    padding: clamp(24px, 4vw, 36px);
  }

  .include h2 {
    font-size: 1.25rem;
    margin-bottom: 18px;
  }

  .include ul {
    display: grid;
    gap: 12px;
  }

  .include li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    color: var(--text);
    line-height: 1.5;
  }

  .include :global(svg) {
    flex-shrink: 0;
    margin-top: 4px;
    color: var(--accent);
  }

  ol {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }

  ol li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
  }

  .marker {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    font-family: var(--font-mono);
    color: var(--amber);
  }

  h3 {
    font-size: 1.0625rem;
    margin: 8px 0 4px;
  }

  ol p {
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
