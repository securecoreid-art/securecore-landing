---
import Page from '../layouts/Page.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import ServiceList from '../components/ServiceList.astro';
import ProcessStrip from '../components/ProcessStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import { content, type Lang } from '../i18n/content';

const { lang } = Astro.props as { lang: Lang };
const t = content[lang];
---

<!--
  Home: each section has one job, so no message repeats.
  1 Hero (who we are, animated) → 2 Who we are + 3 pillars → 3 When to bring us in
  → 4 Services → 5 How we work (+ what you receive) → 6 Call to action
-->
<Page lang={lang} page="home">
  <Hero lang={lang} />
  <Intro lang={lang} />
  <FeatureGrid
    kicker={t.scenarios.kicker}
    title={t.scenarios.title}
    lead={t.scenarios.lead}
    items={t.scenarios.items}
    cols={3}
    variant="plain"
    tinted
  />
  <ServiceList lang={lang} />
  <ProcessStrip lang={lang} />
  <CtaBand lang={lang} />
</Page>
